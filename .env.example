# ── CoddyCheck backend (sync API) ──────────────────────────────────────────
# Production Check API manzili (oxirida /api BO'LMASIN, faqat domen)
CHECK_API_URL=https://your-coddycheck-backend.example.com
# Check .env dagi SYNC_API_KEY bilan AYNAN bir xil bo'lishi shart
SYNC_API_KEY=

# ── Firebase (CoddyResult loyihasi) service account ─────────────────────────
# Variant 1: JSON fayl yo'li (tavsiya)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# Variant 2: JSON ni to'g'ridan-to'g'ri (bitta qatorda) qo'yish ham mumkin:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Result foydalanuvchi login domeni (Result kodidagi phoneToEmail bilan bir xil)
RESULT_EMAIL_DOMAIN=oquv-natija.local

# ── Status chegaralari (finalScore 0-100) ──────────────────────────────────
GOOD_MIN=75       # >=75  -> good
AVERAGE_MIN=50    # 50-74 -> average ; <50 -> poor

# ── Haftalik oyna ───────────────────────────────────────────────────────────
# previous = o'tgan tugagan hafta (Du-Ya) ; current = joriy hafta
WEEK_WINDOW=previous

# ── Cron jadvali (src/cron.js) ──────────────────────────────────────────────
# Kunlik pull (Check -> Result)
PULL_CRON=0 3 * * *
# Haftalik push (Result -> Check) — dushanba 04:00
PUSH_CRON=0 4 * * 1
TZ=Asia/Tashkent

# Sinov rejimi: true bo'lsa Check'ga PATCH yubormaydi, faqat log qiladi
DRY_RUN=false
